# Local Postgres from `docker compose up -d` (see README).
# Production on Render injects this from the Blueprint database.
DATABASE_URL="postgresql://curepacket:curepacket@localhost:5432/curepacket"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
# On Render the Blueprint generates AUTH_SECRET for you.
AUTH_SECRET="replace-with-a-long-random-string"
# Public site URL. On Render this is filled from RENDER_EXTERNAL_URL at startup
# when left blank. Set both AUTH_URL and APP_URL if you add a custom domain.
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Trust the reverse proxy (Render). Safe for local dev as well.
AUTH_TRUST_HOST="true"

# Set to true to create the Harbor & Co. demo login (demo@curepacket.dev / demo1234).
# `npm run dev` always seeds. Production startup seeds only when this is true.
# The Render Blueprint sets it to true for the first deploy. See DEPLOY.md.
SEED_DEMO="true"

# Optional magic-link email (leave unset to use credentials + demo login)
# AUTH_RESEND_KEY=""
# EMAIL_FROM="CurePacket <noreply@localhost>"

# Optional LLM letter extraction (heuristic extractor is always available)
ENABLE_LLM_EXTRACT="false"
OPENAI_API_KEY=""

# Stripe (optional — billing records a local stub when the secret key is unset).
# See DEPLOY.md for where each value comes from and the webhook path
# /api/stripe/webhook. Price IDs are optional; the app creates products on first use.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PACKET_PRICE_ID=""
STRIPE_MONITORING_PRICE_ID=""

# Default packet fee in cents (used when a matching Stripe Price is not already stored)
DEFAULT_PACKET_FEE_CENTS="75000"
MONITORING_FEE_CENTS="4900"

# Public app URL used in packets and checkout redirects.
# Read at runtime. On Render, leave blank unless you use a custom domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
